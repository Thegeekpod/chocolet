<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block access to hidden files/directories (e.g. .env, .git)
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # 2. Block access to sensitive files and extensions
    <FilesMatch "(?i)\.(env|log|sql|sqlite|yml|yaml|ini|sh|bak|dist|conf|json|lock|md)$">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order Deny,Allow
            Deny from all
        </IfModule>
    </FilesMatch>

    # 3. Block direct access to artisan and sensitive files
    <Files "artisan">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order Deny,Allow
            Deny from all
        </IfModule>
    </Files>

    # 4. Block access to internal Laravel directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests)/ - [F,L]

    # 5. Route all other requests to the public/ folder if DocumentRoot is not set to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
